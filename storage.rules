rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // HelpCenterData - Auth required
    match /HelpCenterData/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // hostRequests - Public write, auth required for read
    match /hostRequests/{allPaths=**} {
      allow write: if true;
      allow read: if request.auth != null;
    }

    // Feedback Images - Auth required, max 5MB
    match /Feedback_img/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // ✅ Host Thumbnails - Auth required, max 5MB, only image types
    match /hosts/{hostId}/thumbnails/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == hostId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == hostId;
    }

    // ✅ PublicBucket - FULL PUBLIC ACCESS (read/write anyone)
    match /PublicBucket/{allPaths=**} {
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

  }
}
