rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===================================================
    // HELPER FUNCTIONS
    // ===================================================

    // Admin Check
    function isAdmin() {
      return request.auth != null && request.auth.uid == "UWSPOJ48pnXHAbizdNIHHaMWsRm2";
    }
    
    // User Owner Check (by UID match)
    function isUserOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User specific fields jo wo update kar sakta hai
    function getUserUpdatableFields() {
      return ["unreadNotificationCount", "lastLogin", "fcmToken", "fcmTokenUpdatedAt"];
    }

    // ===================================================
    // 1. Users Collection
    // ===================================================
    match /Users/{userId} {
      allow read: if isUserOwner(userId) || isAdmin();
      allow create, delete: if isAdmin();
      
      // User sirf specific fields update kar sakta hai
      allow update: if isAdmin() || 
        (isUserOwner(userId) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(getUserUpdatableFields()));
      
      match /TransactionHistory/{id} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow write, update, create, delete: if isAdmin();
      }
      
      match /JoinedMatches/{id} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow write, update, create, delete: if isAdmin();
      }
      
      match /Notifications/{id} {
        allow read, write, create, update, delete: if isUserOwner(userId) || isAdmin();
      }
      
      match /{sub}/{doc} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow write, update, create, delete: if isAdmin();
      }
    }

    // ===================================================
    // 2. Admin-only Collections
    // ===================================================
    match /AllUTRs/{doc} {
      allow read, write, update, create, delete: if isAdmin();
    }
    
    match /WithdrawalRequests/{doc} {
      allow read, write, update, create, delete: if isAdmin();
    }
    
    match /TotalWithdrawal/{doc} {
      allow read, write, update, create, delete: if isAdmin();
    }
    
    match /TotalDeposit/{doc} {
      allow read, write, update, create, delete: if isAdmin();
    }

    // ===================================================
    // 3. Public Collections
    // ===================================================
    match /AllReferralCodes/{doc} {
      allow read, write: if request.auth != null;
    }

    // ===================================================
    // 4. User Tracking (CLIENT FULL ACCESS - AUTH ONLY)
    // ===================================================
    match /attempts_tracking/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      allow read, write, create, update, delete: if isAdmin();
    }

    match /user_verifications/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      allow read, write, create, update, delete: if isAdmin();
    }

    // ===================================================
    // 5. AppVersion Collection (PUBLIC READ)
    // ===================================================
    match /AppVersion/oxOggxjiTFhG8MZqNXhd {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }

    // ===================================================
    // 6. Host Applications (PUBLIC CREATE & READ - ADMIN WRITE/DELETE)
    //    - Anyone can create and read (for tracking status without login)
    //    - Only admin can update status or delete
    // ===================================================
    match /applications/{doc} {
      allow create: if true;
      allow read: if true;  // anonymous read for tracking
      allow update, delete: if isAdmin();
    }

    // ===================================================
    // 7. Hosts Collection (Host Profile Data — NO password here)
    //    - Host can READ own doc (profile display)
    //    - Host can UPDATE own doc (profile edit)
    //    - Admin has full access
    //    - Document ID = host's authUid
    // ===================================================
    match /hosts/{hostId} {
      allow read: if isUserOwner(hostId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isUserOwner(hostId) || isAdmin();
      allow delete: if isAdmin();

      // ── myThumbnails subcollection ──
      // Host apne thumbnails read/create kar sakta hai, admin full access
      match /myThumbnails/{thumbId} {
        allow read, create: if isUserOwner(hostId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // ── myMatches subcollection ──
      // Host ke created tournaments ka reference (tournamentId + tournamentType)
      // Doc ID = server timestamp, only store tournamentId and tournamentType
      match /myMatches/{matchId} {
        allow read: if isUserOwner(hostId) || isAdmin();
        allow create: if isUserOwner(hostId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // ── accountBalance subcollection ──
      // Host wallet balance — ONLY READ by host, ALL WRITE by Admin/Functions only
      // Doc ID = "wallet", Field = walletBalance (PAISA int)
      // Host panel uses onSnapshot for realtime balance display
      match /accountBalance/{walletId} {
        allow read: if isUserOwner(hostId) || isAdmin();
        allow write, create, update, delete: if isAdmin();
      }

      // ── transactionHistory subcollection ──
      // Host transactions — ONLY READ by host, ALL WRITE by Admin/Functions only
      // Doc IDs: TJ_xxx (joining), EDM118PRD_xxx (price distribution)
      // Fields: amount, category, status, timestamp, transactionId, transactionType
      match /transactionHistory/{txnId} {
        allow read: if isUserOwner(hostId) || isAdmin();
        allow write, create, update, delete: if isAdmin();
      }
    }

    // ===================================================
    // 8. hostCredentials Collection (ADMIN ONLY — stores passwords)
    //    - Host CANNOT read/write — password is completely hidden
    //    - Only admin can access via Admin SDK / serverless API
    //    - Document ID = host's authUid (same as hosts doc ID)
    // ===================================================
    match /hostCredentials/{hostId} {
      allow read, write, create, update, delete: if isAdmin();
    }

    // ===================================================
    // 9. ✅ NEW: Feedbacks Collection
    //    - User can create/edit/delete only their own feedback
    //    - User can read only their own feedback
    //    - Admin has full access
    //    - Document ID = userId (Firebase Auth UID)
    // ===================================================
    match /Feedbacks/{userId} {
      allow read: if isUserOwner(userId) || isAdmin();
      allow create, update, delete: if isUserOwner(userId) || isAdmin();
      
      // Validate data on write
      allow write: if isUserOwner(userId) || isAdmin() &&
        request.resource.data.keys().hasOnly(["userId", "description", "imageUrl", "timestampIST"]);
    }

    // ===================================================
    // 10. Default (Admin-only catch-all)
    // ===================================================
    match /{doc=**} {
      allow read, write, update, create, delete: if isAdmin();
    }
    
  }
}
